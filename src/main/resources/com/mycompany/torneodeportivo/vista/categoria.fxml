<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="640.0" prefWidth="1100.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.torneodeportivo.controlador.CategoriaController">
   <top>
      <HBox styleClass="barra-titulo">
         <children>
            <Label styleClass="titulo" text="Categorías por edad" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefWidth="290.0" styleClass="panel-form">
         <children>
                  <Label text="Nombre" />
                  <TextField fx:id="txtNombre" promptText="Ej. Sub-20" />
                  <Label fx:id="errNombre" maxWidth="1.7976931348623157E308" styleClass="msg-error" wrapText="true" />
                  <Label text="Edad mínima" />
                  <TextField fx:id="txtEdadMin" promptText="Ej. 17" />
                  <Label fx:id="errEdadMin" maxWidth="1.7976931348623157E308" styleClass="msg-error" wrapText="true" />
                  <Label text="Edad máxima" />
                  <TextField fx:id="txtEdadMax" promptText="Ej. 20" />
                  <Label fx:id="errEdadMax" maxWidth="1.7976931348623157E308" styleClass="msg-error" wrapText="true" />
                  <Label text="Estado" />
                  <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" promptText="Selecciona un estado" />
                  <Label fx:id="errEstado" maxWidth="1.7976931348623157E308" styleClass="msg-error" wrapText="true" />
                  <FlowPane hgap="6.0" vgap="6.0">
                     <children>
                        <Button fx:id="btnNuevo" mnemonicParsing="false" onAction="#nuevo" styleClass="btn-neutro" text="Nuevo" />
                        <Button fx:id="btnValidar" mnemonicParsing="false" onAction="#validar" styleClass="btn-validar" text="Validar" />
                        <Button fx:id="btnGuardar" disable="true" mnemonicParsing="false" onAction="#guardar" styleClass="btn-principal" text="Guardar" />
                        <Button fx:id="btnEditar" disable="true" mnemonicParsing="false" onAction="#editar" styleClass="btn-neutro" text="Editar" />
                        <Button fx:id="btnEliminar" disable="true" mnemonicParsing="false" onAction="#eliminar" styleClass="btn-peligro" text="Eliminar" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar" styleClass="btn-neutro" text="Limpiar" />
                     </children>
                     <padding>
                        <Insets top="8.0" />
                     </padding>
                  </FlowPane>
         </children>
      </VBox>
   </left>
   <center>
      <TableView fx:id="tabla" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colId" prefWidth="50" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="180" text="Nombre" />
            <TableColumn fx:id="colMin" prefWidth="110" text="Edad mín." />
            <TableColumn fx:id="colMax" prefWidth="110" text="Edad máx." />
            <TableColumn fx:id="colEstado" prefWidth="140" text="Estado" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
</BorderPane>
