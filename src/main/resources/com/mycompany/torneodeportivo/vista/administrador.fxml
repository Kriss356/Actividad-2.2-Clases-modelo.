<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="640.0" prefWidth="1100.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.torneodeportivo.controlador.AdministradorController">
   <top>
      <HBox styleClass="barra-titulo">
         <children>
            <Label styleClass="titulo" text="Administradores" />
         </children>
      </HBox>
   </top>
   <left>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="330.0">
         <content>
            <VBox styleClass="panel-form">
               <children>
                  <Label text="Nombre completo" />
                  <TextField fx:id="txtNombre" />
                  <Label fx:id="errNombre" maxWidth="1.7976931348623157E308" styleClass="msg-error" wrapText="true" />
                  <Label text="Edad" />
                  <TextField fx:id="txtEdad" />
                  <Label fx:id="errEdad" maxWidth="1.7976931348623157E308" styleClass="msg-error" wrapText="true" />
                  <Label text="Correo electrónico" />
                  <TextField fx:id="txtCorreo" promptText="nombre@dominio.com" />
                  <Label fx:id="errCorreo" maxWidth="1.7976931348623157E308" styleClass="msg-error" wrapText="true" />
                  <Label text="Usuario" />
                  <TextField fx:id="txtUsuario" />
                  <Label fx:id="errUsuario" maxWidth="1.7976931348623157E308" styleClass="msg-error" wrapText="true" />
                  <Label text="Contraseña" />
                  <PasswordField fx:id="txtContrasena" />
                  <Label fx:id="errContrasena" maxWidth="1.7976931348623157E308" styleClass="msg-error" wrapText="true" />
                  <Label text="Rol" />
                  <ComboBox fx:id="cmbRol" maxWidth="1.7976931348623157E308" promptText="Selecciona un rol" />
                  <Label fx:id="errRol" maxWidth="1.7976931348623157E308" styleClass="msg-error" wrapText="true" />
                  <Label text="Estado" />
                  <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" promptText="Selecciona un estado" />
                  <Label fx:id="errEstado" maxWidth="1.7976931348623157E308" styleClass="msg-error" wrapText="true" />
                  <FlowPane hgap="6.0" vgap="6.0">
                     <children>
                        <Button fx:id="btnNuevo" mnemonicParsing="false" onAction="#nuevo" styleClass="btn-neutro" text="Nuevo" />
                        <Button fx:id="btnValidar" mnemonicParsing="false" onAction="#validar" styleClass="btn-validar" text="Validar" />
                        <Button fx:id="btnGuardar" disable="true" mnemonicParsing="false" onAction="#guardar" styleClass="btn-principal" text="Guardar" />
                        <Button fx:id="btnEditar" disable="true" mnemonicParsing="false" onAction="#editar" styleClass="btn-neutro" text="Editar" />
                        <Button fx:id="btnEliminar" disable="true" mnemonicParsing="false" onAction="#eliminar" styleClass="btn-peligro" text="Eliminar" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar" styleClass="btn-neutro" text="Limpiar" />
                     </children>
                     <padding>
                        <Insets top="8.0" />
                     </padding>
                  </FlowPane>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </left>
   <center>
      <TableView fx:id="tabla" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colId" prefWidth="40" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="150" text="Nombre" />
            <TableColumn fx:id="colEdad" prefWidth="50" text="Edad" />
            <TableColumn fx:id="colCorreo" prefWidth="170" text="Correo" />
            <TableColumn fx:id="colUsuario" prefWidth="110" text="Usuario" />
            <TableColumn fx:id="colRol" prefWidth="150" text="Rol" />
            <TableColumn fx:id="colEstado" prefWidth="90" text="Estado" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
</BorderPane>
