<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="640.0" prefWidth="1100.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.torneodeportivo.controlador.PosicionController">
   <top>
      <VBox>
         <children>
            <HBox styleClass="barra-titulo">
               <children>
                  <Label styleClass="titulo" text="Tabla de posiciones" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="barra-filtro">
               <children>
                  <Label text="Categoría:" />
                  <ComboBox fx:id="cmbCategoria" prefWidth="220.0" promptText="Todas" />
                  <Button mnemonicParsing="false" onAction="#mostrarTodas" styleClass="btn-neutro" text="Mostrar todas" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarTabla" styleClass="btn-principal" text="Actualizar tabla" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tabla" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colPos" prefWidth="40.0" text="#" />
            <TableColumn fx:id="colEquipo" prefWidth="170.0" text="Equipo" />
            <TableColumn fx:id="colPJ" prefWidth="50.0" text="PJ" />
            <TableColumn fx:id="colG" prefWidth="50.0" text="G" />
            <TableColumn fx:id="colE" prefWidth="50.0" text="E" />
            <TableColumn fx:id="colP" prefWidth="50.0" text="P" />
            <TableColumn fx:id="colGF" prefWidth="50.0" text="GF" />
            <TableColumn fx:id="colGC" prefWidth="50.0" text="GC" />
            <TableColumn fx:id="colDG" prefWidth="50.0" text="DG" />
            <TableColumn fx:id="colPts" prefWidth="60.0" text="Pts" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <Label fx:id="lblResumen" maxWidth="1.7976931348623157E308" styleClass="resumen" />
   </bottom>
</BorderPane>
