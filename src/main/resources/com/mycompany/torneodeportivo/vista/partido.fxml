<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="640.0" prefWidth="1100.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.torneodeportivo.controlador.PartidoController">
   <top>
      <HBox styleClass="barra-titulo">
         <children>
            <Label styleClass="titulo" text="Partidos y resultados" />
         </children>
      </HBox>
   </top>
   <left>
      <ScrollPane fx:id="panelForm" fitToWidth="true" hbarPolicy="NEVER" prefWidth="320.0">
         <content>
            <VBox styleClass="panel-form">
               <children>
                  <Label text="Equipo local" />
                  <ComboBox fx:id="cmbLocal" maxWidth="1.7976931348623157E308" promptText="Selecciona el local" />
                  <Label text="Equipo visitante" />
                  <ComboBox fx:id="cmbVisitante" maxWidth="1.7976931348623157E308" promptText="Selecciona el visitante" />
                  <Label text="Fecha" />
                  <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308" />
                  <Label text="Hora (HH:mm)" />
                  <TextField fx:id="txtHora" promptText="Ej. 16:30" />
                  <Label text="Lugar" />
                  <TextField fx:id="txtLugar" promptText="Ej. Cancha principal" />
                  <Label text="Estado del partido" />
                  <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" promptText="Selecciona un estado" />
                  <FlowPane hgap="6.0" vgap="6.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#nuevo" styleClass="btn-neutro" text="Nuevo" />
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" styleClass="btn-principal" text="Guardar" />
                        <Button mnemonicParsing="false" onAction="#editar" styleClass="btn-neutro" text="Editar" />
                        <Button mnemonicParsing="false" onAction="#eliminar" styleClass="btn-peligro" text="Eliminar" />
                        <Button mnemonicParsing="false" onAction="#limpiar" styleClass="btn-neutro" text="Limpiar" />
                     </children>
                     <padding>
                        <Insets top="6.0" />
                     </padding>
                  </FlowPane>
                  <Separator />
                  <Label styleClass="subtitulo" text="Resultado (partido seleccionado)" />
                  <HBox spacing="8.0">
                     <children>
                        <TextField fx:id="txtGolesLocal" promptText="Goles local" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtGolesVisitante" promptText="Goles visit." HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <ComboBox fx:id="cmbEstadoResultado" maxWidth="1.7976931348623157E308" promptText="Estado del resultado" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrarResultado" styleClass="btn-principal" text="Registrar resultado" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </left>
   <center>
      <TableView fx:id="tabla" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
            <TableColumn fx:id="colLocal" prefWidth="110.0" text="Local" />
            <TableColumn fx:id="colVisitante" prefWidth="110.0" text="Visitante" />
            <TableColumn fx:id="colFecha" prefWidth="90.0" text="Fecha" />
            <TableColumn fx:id="colHora" prefWidth="60.0" text="Hora" />
            <TableColumn fx:id="colLugar" prefWidth="110.0" text="Lugar" />
            <TableColumn fx:id="colEstado" prefWidth="95.0" text="Estado" />
            <TableColumn fx:id="colMarcador" prefWidth="70.0" text="Marcador" />
            <TableColumn fx:id="colGanador" prefWidth="95.0" text="Ganador" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
</BorderPane>
