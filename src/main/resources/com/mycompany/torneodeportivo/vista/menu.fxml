<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="raiz" prefHeight="700.0" prefWidth="1100.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.torneodeportivo.controlador.MenuController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="barra-menu">
         <children>
            <Label styleClass="logo-menu" text="⚽ Torneo Universitario" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCategorias" mnemonicParsing="false" onAction="#irCategorias" styleClass="btn-menu" text="Categorías" />
            <Button fx:id="btnEquipos" mnemonicParsing="false" onAction="#irEquipos" styleClass="btn-menu" text="Equipos" />
            <Button fx:id="btnJugadores" mnemonicParsing="false" onAction="#irJugadores" styleClass="btn-menu" text="Jugadores" />
            <Button fx:id="btnPartidos" mnemonicParsing="false" onAction="#irPartidos" styleClass="btn-menu" text="Partidos" />
            <Button fx:id="btnAdministradores" mnemonicParsing="false" onAction="#irAdministradores" styleClass="btn-menu" text="Administradores" />
            <Button fx:id="btnPosiciones" mnemonicParsing="false" onAction="#irPosiciones" styleClass="btn-menu" text="Posiciones" />
            <Label fx:id="lblUsuario" styleClass="texto-usuario" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="btn-peligro" text="Cerrar sesión" />
         </children>
         <padding>
            <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
         </padding>
      </HBox>
   </top>
</BorderPane>
