<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="640.0" prefWidth="1100.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.torneodeportivo.controlador.JugadorController">
   <top>
      <HBox styleClass="barra-titulo">
         <children>
            <Label styleClass="titulo" text="Jugadores" />
         </children>
      </HBox>
   </top>
   <left>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="320.0">
         <content>
            <VBox styleClass="panel-form">
               <children>
                  <Label text="Nombre completo" />
                  <TextField fx:id="txtNombre" />
                  <Label text="Edad" />
                  <TextField fx:id="txtEdad" />
                  <Label text="Número de camiseta" />
                  <TextField fx:id="txtNumero" />
                  <Label text="Posición en el campo" />
                  <ComboBox fx:id="cmbPosicion" maxWidth="1.7976931348623157E308" promptText="Selecciona una posición" />
                  <Label text="Equipo" />
                  <ComboBox fx:id="cmbEquipo" maxWidth="1.7976931348623157E308" promptText="Selecciona un equipo" />
                  <Label text="Estado" />
                  <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" promptText="Selecciona un estado" />
                  <Label text="Foto del jugador" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <StackPane prefHeight="100.0" prefWidth="100.0" styleClass="vista-previa">
                           <children>
                              <ImageView fx:id="imgFoto" fitHeight="96.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true" />
                           </children>
                        </StackPane>
                        <Button mnemonicParsing="false" onAction="#seleccionarFoto" styleClass="btn-neutro" text="Seleccionar..." />
                     </children>
                  </HBox>
                  <FlowPane hgap="6.0" vgap="6.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#nuevo" styleClass="btn-neutro" text="Nuevo" />
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" styleClass="btn-principal" text="Guardar" />
                        <Button mnemonicParsing="false" onAction="#editar" styleClass="btn-neutro" text="Editar" />
                        <Button mnemonicParsing="false" onAction="#eliminar" styleClass="btn-peligro" text="Eliminar" />
                        <Button mnemonicParsing="false" onAction="#limpiar" styleClass="btn-neutro" text="Limpiar" />
                     </children>
                     <padding>
                        <Insets top="8.0" />
                     </padding>
                  </FlowPane>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </left>
   <center>
      <TableView fx:id="tabla" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="170.0" text="Nombre" />
            <TableColumn fx:id="colEdad" prefWidth="55.0" text="Edad" />
            <TableColumn fx:id="colNumero" prefWidth="70.0" text="Número" />
            <TableColumn fx:id="colPosicion" prefWidth="120.0" text="Posición" />
            <TableColumn fx:id="colEquipo" prefWidth="130.0" text="Equipo" />
            <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
</BorderPane>
